{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "showmaster",
  "version": "0.1.0",
  "identifier": "showmasterid",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "showmaster",
        "width": 1280,
        "height": 704,
        "minWidth": 640,
        "minHeight": 352,
        "maxWidth": 1280,
        "maxHeight": 704,
        "center": true,
        "fullscreen": false,
        "resizable": false,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$EXE/media/**",
          "$EXE/../../media/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
